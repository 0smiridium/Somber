{
  /* Ultra-modern typography & spacing */
  LargeDisplayFont = "Liberation Sans,sans serif:pixelsize=28";
  WindowTitleFont  = "Inter, Liberation Sans, sans serif:bold:pixelsize=14";
  MenuTitleFont    = "Inter, Liberation Sans, sans serif:medium:pixelsize=12";
  MenuTextFont     = "Inter, Liberation Sans, sans serif:pixelsize=12";
  DisplayFont      = "Inter, Liberation Sans, sans serif:pixelsize=12";
  IconTitleFont    = "Inter, Liberation Sans, sans serif:pixelsize=10";
  ClipTitleFont    = "Inter, Liberation Sans, sans serif:bold:pixelsize=11";

  /* Palette: very dark surfaces, single bold purple accent */
  MenuTextColor    = "#eef2ff";
  MenuTitleColor   = "#fbfbff";
  FTitleColor      = "#f7f7fb";
  MenuDisabledColor= "#6b778a";
  CClipTitleColor  = "#97a8c3";
  HighlightColor   = "#7c4dff"; /* purple accent */
  HighlightTextColor = "#ffffff";

  /* Flat, minimal chrome with elevated contrast for active elements */
  FTitleBack       = (solid, "#0f1114");
  UTitleBack       = (solid, "#0b0d10");
  PTitleBack       = (solid, "#0c0e12");

  /* Taskbar/menu surface tuned for a modern dock-like feel */
  MenuTitleBack    = (solid, "#07070a");
  MenuTextBack     = (solid, "#0b0d10");
  WorkspaceBack    = (solid, "#060609");

  /* Cursor */
  NormalCursor = (builtin, left_ptr);

  /* Spacious, touch-friendly spacing */
  MenuTextExtendSpace = 6;
  MenuTitleExtendSpace = 6;
  WindowTitleExtendSpace = 4;

  /* Left aligned titles for quick scanning */
  TitleJustify = left;
  MenuStyle = flat;
}
