{
  /* Modern typography: compact, readable, and consistent across controls. */
  LargeDisplayFont = "Liberation Sans,sans serif:pixelsize=26";
  WindowTitleFont = "Liberation Sans,sans serif:bold:pixelsize=13";
  MenuTitleFont = "Liberation Sans,sans serif:bold:pixelsize=11";
  MenuTextFont = "Liberation Sans,sans serif:pixelsize=11";
  DisplayFont = "Liberation Sans,sans serif:pixelsize=11";
  IconTitleFont = "Liberation Sans,sans serif:pixelsize=10";
  ClipTitleFont = "Liberation Sans,sans serif:bold:pixelsize=11";

  /* Calm charcoal surfaces with a single, high-visibility accent. */
  MenuTextColor = "#e7edf5";
  MenuTitleColor = "#f7f9fc";
  FTitleColor = "#f5f7fa";
  UTitleColor = "#c7d0dc";
  PTitleColor = "#dce4ee";
  MenuDisabledColor = "#718096";
  ClipTitleColor = "#e7edf5";
  IconTitleColor = "#e7edf5";
  CClipTitleColor = "#93a4b8";
  HighlightColor = "#4f8cff";
  HighlightTextColor = "#ffffff";

  /* Restrained window chrome: depth comes from contrast, not bevels. */
  FTitleBack = (solid, "#252d38");
  UTitleBack = (solid, "#1b222c");
  PTitleBack = (solid, "#202936");

  /* The menu/title strip doubles as a clean taskbar surface. */
  MenuTitleBack = (solid, "#151b24");
  MenuTextBack = (solid, "#1b222c");

  ResizebarBack = (solid, "#11161e");
  IconBack = (solid, "#202936");
  IconTitleBack = "#202936";
  WorkspaceBack = (solid, "#0d1117");

  NormalCursor = (builtin, left_ptr);

  /* Roomier hit targets without oversized, old-style chrome. */
  MenuTextExtendSpace = 4;
  MenuTitleExtendSpace = 5;
  WindowTitleExtendSpace = 2;

  /* Left-aligned titles scan more naturally in a modern desktop layout. */
  TitleJustify = left;
  MenuStyle = flat;
}
